<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F2F2F7">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Washing Machine"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etMachineName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Machine Name"
        android:inputType="textCapWords"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etMachineId"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Machine ID (e.g., home, washer_1, 001)"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- NEW: MAC Address field for pairing -->
    <EditText
        android:id="@+id/etMacAddress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="ESP32 MAC Address (from Serial Monitor)"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How to get MAC address:\n1. Open Arduino Serial Monitor\n2. Look for 'MAC: XX:XX:XX:XX:XX:XX'\n3. Enter it above"
        android:textSize="12sp"
        android:textColor="#8E8E93"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnAddMachine"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Add and Pair Machine"
        android:textAllCaps="false"
        android:backgroundTint="#007AFF"/>

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:backgroundTint="#8E8E93"/>

</LinearLayout>